{
	"schemaVersion": 1,
	"id": "emberfall-core",
	"version": "${version}",
	"name": "Emberfall Core",
	"description": "Core mod for Emberfall Events",
	"authors": [
		"SpaxxV"
	],
	"contact": {
		"homepage": "https://emberfallevents.com/",
		"sources": ""
	},
	"license": "CC0-1.0",
	"icon": "assets/emberfall-core/icon.png",
